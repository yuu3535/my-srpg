# Clip Studio Paint 作業ファイル
*.clip

# 裏作業フォルダ（ゲームに不要な作業用ファイル）
裏作業/

# Python作業生成物・立ち絵分離モデル
__pycache__/
*.pyc
.u2net/

# 人手仕上げ前の立ち絵素材
立ち絵透過下処理/

# Unity prototype generated folders
unity-prototype/[Ll]ibrary/
unity-prototype/[Tt]emp/
unity-prototype/[Oo]bj/
unity-prototype/[Ll]ogs/
unity-prototype/[Uu]ser[Ss]ettings/
unity-prototype/[Bb]uild/
unity-prototype/[Bb]uilds/
unity-prototype/MemoryCaptures/
unity-prototype/Recordings/

# Unity Pipeline transient assets
unity-prototype/Assets/Settings/Pipeline/Resources/RuntimePipelineConfig.asset*
unity-prototype/Assets/Settings/Pipeline/Resources/RuntimePipelineBuildInfo.asset*
unity-prototype/PlaythroughShots/
# Unity の確認用の画像（組み立てのたびに撮り直す。数百MBになるので Git に入れない。手元のフォルダで見る。2026-09-28）
unity-prototype/Assets/Previews/
unity-prototype/Assets/Previews.meta

# 手元だけで使う素材（再配布禁止の VRM など。2026-10-07）
unity-prototype/Assets/LocalOnly/
unity-prototype/Assets/LocalOnly.meta
